{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/EmbeddingReindexRequest.json",
  "title": "EmbeddingReindexRequest",
  "type": "object",
  "description": "重建 Recall 向量索引。",
  "additionalProperties": false,
  "properties": {
    "prefix": {
      "type": "string",
      "description": "要索引的 Recall 路径前缀。"
    },
    "max_entries": {
      "type": "integer",
      "description": "最多索引条目数。",
      "minimum": 1,
      "maximum": 2000
    }
  }
}
