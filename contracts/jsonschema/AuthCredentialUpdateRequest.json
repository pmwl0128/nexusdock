{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/AuthCredentialUpdateRequest.json",
  "title": "AuthCredentialUpdateRequest",
  "type": "object",
  "description": "管理员密码更新请求。",
  "additionalProperties": false,
  "properties": {
    "current": {
      "type": "string",
      "description": "当前密码。",
      "minLength": 1,
      "maxLength": 1024
    },
    "next": {
      "type": "string",
      "description": "符合策略的新密码。",
      "minLength": 12,
      "maxLength": 1024
    }
  },
  "required": [
    "current",
    "next"
  ]
}
