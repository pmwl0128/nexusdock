{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/BackupStatus.json",
  "title": "BackupStatus",
  "type": "object",
  "description": "AgentDock 与 Nexus 的单一备份状态。",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "稳定备份标识。"
    },
    "title": {
      "type": "string",
      "description": "备份名称。"
    },
    "description": {
      "type": "string",
      "description": "备份内容说明。"
    },
    "provider": {
      "type": "string",
      "description": "计划执行提供方。"
    },
    "host": {
      "type": "string",
      "description": "执行主机。"
    },
    "enabled": {
      "type": "boolean",
      "description": "备份是否启用。"
    },
    "schedule": {
      "type": "string",
      "description": "可读计划。"
    },
    "schedule_type": {
      "type": "string",
      "description": "计划类型。"
    },
    "state": {
      "type": "string",
      "description": "备份状态。",
      "enum": [
        "never_run",
        "queued",
        "running",
        "success",
        "failed",
        "unknown",
        "disabled"
      ]
    },
    "last_started_at": {
      "type": "string",
      "description": "RFC 3339 UTC 时间。",
      "format": "date-time"
    },
    "last_completed_at": {
      "type": "string",
      "description": "RFC 3339 UTC 时间。",
      "format": "date-time"
    },
    "next_run_at": {
      "type": "string",
      "description": "RFC 3339 UTC 时间。",
      "format": "date-time"
    },
    "message": {
      "type": "string",
      "description": "状态说明。"
    },
    "archive": {
      "type": "string",
      "description": "最近归档文件名。"
    },
    "archive_size": {
      "type": "integer",
      "description": "最近归档字节数。",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "description": "最近归档 SHA-256。"
    },
    "remote_path": {
      "type": "string",
      "description": "脱敏后的远端路径。"
    },
    "history": {
      "type": "array",
      "description": "最近备份历史。",
      "items": {
        "$ref": "#/$defs/BackupHistory"
      }
    }
  },
  "required": [
    "id",
    "title",
    "provider",
    "host",
    "enabled",
    "schedule",
    "state",
    "next_run_at",
    "history"
  ],
  "$defs": {
    "BackupHistory": {
      "type": "object",
      "description": "一次备份执行的脱敏结果。",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "description": "状态文件版本。",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "description": "备份状态。",
          "enum": [
            "never_run",
            "queued",
            "running",
            "success",
            "failed",
            "unknown",
            "disabled"
          ]
        },
        "message": {
          "type": "string",
          "description": "状态说明。"
        },
        "started_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "host": {
          "type": "string",
          "description": "执行主机。"
        },
        "archive": {
          "type": "string",
          "description": "归档文件名。"
        },
        "archive_size": {
          "type": "integer",
          "description": "归档字节数。",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "description": "归档 SHA-256。"
        },
        "remote_path": {
          "type": "string",
          "description": "脱敏后的远端路径。"
        }
      },
      "required": [
        "state"
      ]
    }
  }
}
