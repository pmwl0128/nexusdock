{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/RecallSearchResult.json",
  "title": "RecallSearchResult",
  "type": "object",
  "description": "Recall 关键词搜索命中。",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "description": "Recall 相对路径。"
    },
    "title": {
      "type": "string",
      "description": "Markdown 标题。"
    },
    "snippet": {
      "type": "string",
      "description": "命中位置附近的文本片段。"
    },
    "frontmatter": {
      "type": "object",
      "description": "命中文档 Frontmatter。",
      "additionalProperties": {
        "type": "string",
        "description": "Frontmatter 字段值。"
      },
      "properties": {}
    },
    "matched_terms": {
      "type": "array",
      "description": "命中的查询词。",
      "items": {
        "type": "string",
        "description": "查询词。"
      }
    },
    "matched_fields": {
      "type": "array",
      "description": "命中的文档字段。",
      "items": {
        "type": "string",
        "description": "字段名。"
      }
    }
  },
  "required": [
    "path",
    "snippet",
    "frontmatter"
  ]
}
