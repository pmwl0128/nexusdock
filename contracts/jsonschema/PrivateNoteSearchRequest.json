{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteSearchRequest.json",
  "title": "PrivateNoteSearchRequest",
  "type": "object",
  "description": "私密笔记元数据检索请求。",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "description": "仅匹配标题、简介、标签、分类和路径的查询。"
    },
    "max_results": {
      "type": "integer",
      "description": "最大结果数。",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "query"
  ]
}
