{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/BackupHistory.json",
  "title": "BackupHistory",
  "type": "object",
  "description": "一次备份执行的脱敏结果。",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "状态文件版本。",
      "minimum": 0
    },
    "state": {
      "type": "string",
      "description": "备份状态。",
      "enum": [
        "never_run",
        "queued",
        "running",
        "success",
        "failed",
        "unknown",
        "disabled"
      ]
    },
    "message": {
      "type": "string",
      "description": "状态说明。"
    },
    "started_at": {
      "type": "string",
      "description": "RFC 3339 UTC 时间。",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "description": "RFC 3339 UTC 时间。",
      "format": "date-time"
    },
    "host": {
      "type": "string",
      "description": "执行主机。"
    },
    "archive": {
      "type": "string",
      "description": "归档文件名。"
    },
    "archive_size": {
      "type": "integer",
      "description": "归档字节数。",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "description": "归档 SHA-256。"
    },
    "remote_path": {
      "type": "string",
      "description": "脱敏后的远端路径。"
    }
  },
  "required": [
    "state"
  ]
}
