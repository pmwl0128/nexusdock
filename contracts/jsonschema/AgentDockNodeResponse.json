{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/AgentDockNodeResponse.json",
  "title": "AgentDockNodeResponse",
  "type": "object",
  "description": "单个 AgentDock 节点响应。",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "请求是否成功。"
    },
    "node": {
      "$ref": "#/$defs/AgentDockNode"
    }
  },
  "required": [
    "ok",
    "node"
  ],
  "$defs": {
    "AgentDockNode": {
      "type": "object",
      "description": "Nexus 管理的一台 AgentDock Runtime 节点。",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "稳定节点 ID。",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "description": "节点显示名称。",
          "minLength": 1,
          "maxLength": 100
        },
        "endpoint": {
          "type": "string",
          "description": "AgentDock HTTP/HTTPS Origin。",
          "format": "uri"
        },
        "enabled": {
          "type": "boolean",
          "description": "节点是否允许 Runtime 请求。"
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "请求超时秒数。",
          "minimum": 1,
          "maximum": 300
        },
        "token_configured": {
          "type": "boolean",
          "description": "节点 Token 是否已配置；不会返回 Token 原值。"
        },
        "created_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "endpoint",
        "enabled",
        "timeout_seconds",
        "token_configured",
        "created_at",
        "updated_at"
      ]
    }
  }
}
