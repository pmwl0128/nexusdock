{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/RecallEntry.json",
  "title": "RecallEntry",
  "type": "object",
  "description": "Markdown 召回条目。",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "description": "召回相对路径。"
    },
    "content": {
      "type": "string",
      "description": "Markdown 或文本内容。"
    },
    "size_bytes": {
      "type": "integer",
      "description": "内容字节数。",
      "minimum": 0
    },
    "modified_at": {
      "type": "string",
      "description": "RFC 3339 UTC 时间。",
      "format": "date-time"
    }
  },
  "required": [
    "path"
  ]
}
