{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteWriteResponse.json",
  "title": "PrivateNoteWriteResponse",
  "type": "object",
  "description": "私密笔记明文与 age 密文原子写入结果。",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "description": "固定为 write。"
    },
    "root": {
      "type": "string",
      "description": "Nexus 私密笔记根目录。"
    },
    "path": {
      "type": "string",
      "description": "明文相对路径。"
    },
    "encrypted_path": {
      "type": "string",
      "description": "age 密文相对路径。"
    },
    "written": {
      "type": "boolean",
      "description": "明文是否写入。"
    },
    "encrypted": {
      "type": "boolean",
      "description": "密文是否写入。"
    },
    "algorithm": {
      "type": "string",
      "description": "加密算法。"
    }
  },
  "required": [
    "action",
    "root",
    "path",
    "encrypted_path",
    "written",
    "encrypted",
    "algorithm"
  ]
}
