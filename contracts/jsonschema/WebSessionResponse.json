{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/WebSessionResponse.json",
  "title": "WebSessionResponse",
  "type": "object",
  "description": "当前或新创建的管理员浏览器会话。",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "请求是否成功。"
    },
    "session": {
      "$ref": "#/$defs/WebSession"
    }
  },
  "required": [
    "ok",
    "session"
  ],
  "$defs": {
    "WebSession": {
      "type": "object",
      "description": "已脱敏的管理员浏览器会话。",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "会话 ID。"
        },
        "user_id": {
          "type": "string",
          "description": "管理员用户 ID。"
        },
        "username": {
          "type": "string",
          "description": "管理员用户名。"
        },
        "display_name": {
          "type": "string",
          "description": "管理员显示名称。"
        },
        "remember_me": {
          "type": "boolean",
          "description": "是否为记住登录会话。"
        },
        "ip_prefix": {
          "type": "string",
          "description": "脱敏后的客户端网络前缀。"
        },
        "user_agent_summary": {
          "type": "string",
          "description": "脱敏后的客户端摘要。"
        },
        "created_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "last_seen_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "idle_expires_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "absolute_expires_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "must_change_password": {
          "type": "boolean",
          "description": "是否必须先更新管理员密码。"
        },
        "csrf_token": {
          "type": "string",
          "description": "仅当前会话返回的 CSRF Token。"
        },
        "current": {
          "type": "boolean",
          "description": "是否为当前浏览器会话。"
        }
      },
      "required": [
        "id",
        "user_id",
        "username",
        "display_name",
        "remember_me",
        "ip_prefix",
        "user_agent_summary",
        "created_at",
        "last_seen_at",
        "idle_expires_at",
        "absolute_expires_at",
        "must_change_password"
      ]
    }
  }
}
