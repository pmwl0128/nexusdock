{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/LegacyErrorEnvelope.json",
  "title": "LegacyErrorEnvelope",
  "type": "object",
  "description": "Nexus 与浏览器接口使用的错误信封。",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "固定为 false。"
    },
    "request_id": {
      "type": "string",
      "description": "请求关联 ID。"
    },
    "error": {
      "type": "object",
      "description": "错误详情。",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "稳定错误码。"
        },
        "message": {
          "type": "string",
          "description": "可读错误说明。"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "ok",
    "request_id",
    "error"
  ]
}
