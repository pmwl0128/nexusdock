{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteSummary.json",
  "title": "PrivateNoteSummary",
  "type": "object",
  "description": "私密笔记安全元数据；不包含正文或正文片段。",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "description": "notes/ 下的私密笔记相对路径。"
    },
    "encrypted_path": {
      "type": "string",
      "description": "对应 age 密文相对路径。"
    },
    "category": {
      "type": "string",
      "description": "私密笔记分类。"
    },
    "title": {
      "type": "string",
      "description": "私密笔记标题。"
    },
    "summary": {
      "type": "string",
      "description": "人工维护的安全简介。"
    },
    "tags": {
      "type": "array",
      "description": "安全标签。",
      "items": {
        "type": "string",
        "description": "标签。"
      }
    },
    "updated_at": {
      "type": "string",
      "description": "RFC 3339 UTC 时间。",
      "format": "date-time"
    },
    "contains_secret": {
      "type": "boolean",
      "description": "正文是否被标记为含敏感信息。"
    },
    "score": {
      "type": "integer",
      "description": "元数据检索匹配分数。",
      "minimum": 0
    }
  },
  "required": [
    "path",
    "encrypted_path",
    "contains_secret"
  ]
}
