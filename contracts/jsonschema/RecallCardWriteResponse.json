{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/RecallCardWriteResponse.json",
  "title": "RecallCardWriteResponse",
  "type": "object",
  "description": "卡片及其 Recall 文件写入结果。",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "请求是否成功。"
    },
    "card": {
      "$ref": "#/$defs/RecallCard"
    },
    "warnings": {
      "type": "array",
      "description": "已接受的规范警告。",
      "items": {
        "type": "string",
        "description": "警告。"
      }
    },
    "recall": {
      "$ref": "#/$defs/RecallRecord"
    },
    "index_policy": {
      "type": "string",
      "description": "卡片索引策略说明。"
    }
  },
  "required": [
    "ok",
    "card",
    "recall",
    "index_policy"
  ],
  "$defs": {
    "RecallCard": {
      "type": "object",
      "description": "规范化后的 Recall 卡片。",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "卡片标题。"
        },
        "content": {
          "type": "string",
          "description": "卡片正文。"
        },
        "type": {
          "type": "string",
          "description": "卡片类型。"
        },
        "scope": {
          "type": "string",
          "description": "卡片作用域。"
        },
        "project": {
          "type": "string",
          "description": "项目标识。"
        },
        "status": {
          "type": "string",
          "description": "卡片状态。"
        },
        "confidence": {
          "type": "string",
          "description": "卡片可信度。"
        },
        "tags": {
          "type": "array",
          "description": "规范化标签。",
          "items": {
            "type": "string",
            "description": "标签。"
          }
        },
        "source": {
          "type": "string",
          "description": "信息来源。"
        },
        "evidence": {
          "type": "string",
          "description": "验证证据。"
        },
        "boundary": {
          "type": "string",
          "description": "适用边界。"
        },
        "path": {
          "type": "string",
          "description": "最终 Recall 相对路径。"
        }
      },
      "required": [
        "title",
        "content",
        "type",
        "scope",
        "project",
        "status",
        "confidence",
        "source",
        "path"
      ]
    },
    "RecallRecord": {
      "type": "object",
      "description": "读取或写入后的完整 Recall 文本记录。",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Recall 相对路径。"
        },
        "content": {
          "type": "string",
          "description": "包含 Frontmatter 的完整文本。"
        },
        "body": {
          "type": "string",
          "description": "移除 Frontmatter 后的正文。"
        },
        "frontmatter": {
          "type": "object",
          "description": "解析后的 Frontmatter 字符串字段。",
          "additionalProperties": {
            "type": "string",
            "description": "Frontmatter 字段值。"
          },
          "properties": {}
        },
        "size_bytes": {
          "type": "integer",
          "description": "文本字节数。",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "content",
        "body",
        "frontmatter",
        "size_bytes"
      ]
    }
  }
}
