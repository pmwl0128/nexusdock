{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/RecallCardRequest.json",
  "title": "RecallCardRequest",
  "type": "object",
  "description": "捕获或写入一张可复用 Recall 卡片。",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "卡片标题。",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "description": "卡片正文。"
    },
    "summary": {
      "type": "string",
      "description": "content 为空时使用的摘要正文。"
    },
    "type": {
      "type": "string",
      "description": "卡片类型。",
      "enum": [
        "preference",
        "runbook",
        "bug_pattern",
        "deploy_note",
        "project_trap",
        "architecture",
        "decision",
        "anti_pattern"
      ]
    },
    "scope": {
      "type": "string",
      "description": "卡片作用域。",
      "enum": [
        "global",
        "project",
        "device"
      ]
    },
    "project": {
      "type": "string",
      "description": "项目标识；为空时使用 global。"
    },
    "status": {
      "type": "string",
      "description": "卡片状态。",
      "enum": [
        "inbox",
        "active",
        "verified",
        "stale",
        "archived",
        "rejected",
        "conflicted",
        "unverified",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "string",
      "description": "卡片可信度。",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ]
    },
    "tags": {
      "type": "array",
      "description": "卡片标签。",
      "items": {
        "type": "string",
        "description": "标签。"
      }
    },
    "source": {
      "type": "string",
      "description": "卡片信息来源。"
    },
    "evidence": {
      "type": "string",
      "description": "验证卡片内容的证据。"
    },
    "boundary": {
      "type": "string",
      "description": "卡片适用边界。"
    },
    "path": {
      "type": "string",
      "description": "可选的 recall/managed/cards/ 自定义路径。"
    },
    "confirmed": {
      "type": "boolean",
      "description": "真实写入时必须为 true。"
    },
    "overwrite": {
      "type": "boolean",
      "description": "是否覆盖同路径卡片。"
    },
    "allow_warnings": {
      "type": "boolean",
      "description": "是否在已审阅后接受规范警告。"
    },
    "max_results": {
      "type": "integer",
      "description": "捕获阶段相似项最大数量。",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "title"
  ]
}
