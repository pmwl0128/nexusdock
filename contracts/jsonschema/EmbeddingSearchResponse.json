{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/EmbeddingSearchResponse.json",
  "title": "EmbeddingSearchResponse",
  "type": "object",
  "description": "Recall 向量搜索结果。",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "请求是否成功。"
    },
    "enabled": {
      "type": "boolean",
      "description": "嵌入服务是否启用。"
    },
    "model": {
      "type": "string",
      "description": "查询使用的嵌入模型。"
    },
    "query": {
      "type": "string",
      "description": "原始语义查询。"
    },
    "results": {
      "type": "array",
      "description": "按相似度降序排列的命中。",
      "items": {
        "$ref": "#/$defs/EmbeddingSearchHit"
      }
    },
    "count": {
      "type": "integer",
      "description": "返回命中数量。",
      "minimum": 0
    },
    "index": {
      "$ref": "#/$defs/EmbeddingIndexSummary"
    }
  },
  "required": [
    "ok",
    "enabled",
    "model",
    "query",
    "results",
    "count",
    "index"
  ],
  "$defs": {
    "EmbeddingIndexSummary": {
      "type": "object",
      "description": "Recall 向量索引摘要。",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "description": "索引使用的嵌入模型。"
        },
        "dimension": {
          "type": "integer",
          "description": "向量维度。",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "description": "索引文档数量。",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "model",
        "count",
        "updated_at"
      ]
    },
    "EmbeddingSearchHit": {
      "type": "object",
      "description": "Recall 向量搜索命中。",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Recall 相对路径。"
        },
        "title": {
          "type": "string",
          "description": "Markdown 标题。"
        },
        "score": {
          "type": "number",
          "description": "余弦相似度。",
          "minimum": -1,
          "maximum": 1
        },
        "snippet": {
          "type": "string",
          "description": "文档文本片段。"
        },
        "frontmatter": {
          "type": "object",
          "description": "命中文档 Frontmatter。",
          "additionalProperties": {
            "type": "string",
            "description": "Frontmatter 字段值。"
          },
          "properties": {}
        }
      },
      "required": [
        "path",
        "score",
        "snippet"
      ]
    }
  }
}
