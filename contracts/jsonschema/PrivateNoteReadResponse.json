{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteReadResponse.json",
  "title": "PrivateNoteReadResponse",
  "type": "object",
  "description": "显式私密笔记明文读取结果。",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "description": "固定为 read。"
    },
    "root": {
      "type": "string",
      "description": "Nexus 私密笔记根目录。"
    },
    "path": {
      "type": "string",
      "description": "明文相对路径。"
    },
    "encrypted_path": {
      "type": "string",
      "description": "age 密文相对路径。"
    },
    "content": {
      "type": "string",
      "description": "私密笔记明文，仅显式读取接口返回。"
    },
    "truncated": {
      "type": "boolean",
      "description": "正文是否被截断。"
    },
    "contains_secret": {
      "type": "boolean",
      "description": "正文是否被标记为含敏感信息。"
    }
  },
  "required": [
    "action",
    "root",
    "path",
    "encrypted_path",
    "content",
    "truncated",
    "contains_secret"
  ]
}
