{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/AgentDockNodeCreateRequest.json",
  "title": "AgentDockNodeCreateRequest",
  "type": "object",
  "description": "新增 AgentDock 节点。",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "稳定节点 ID。",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "description": "节点显示名称。",
      "minLength": 1,
      "maxLength": 100
    },
    "endpoint": {
      "type": "string",
      "description": "AgentDock HTTP/HTTPS Origin。",
      "format": "uri"
    },
    "token": {
      "type": "string",
      "description": "该节点独立 Bearer Token。",
      "minLength": 1,
      "maxLength": 16384,
      "writeOnly": true
    },
    "enabled": {
      "type": "boolean",
      "description": "节点是否启用。"
    },
    "timeout_seconds": {
      "type": "integer",
      "description": "请求超时秒数。",
      "minimum": 1,
      "maximum": 300
    }
  },
  "required": [
    "id",
    "name",
    "endpoint",
    "token"
  ]
}
