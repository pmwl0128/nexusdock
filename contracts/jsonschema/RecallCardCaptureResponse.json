{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/RecallCardCaptureResponse.json",
  "title": "RecallCardCaptureResponse",
  "type": "object",
  "description": "卡片写入前的规范化、风险提示和去重计划。",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "请求是否成功。"
    },
    "card": {
      "$ref": "#/$defs/RecallCard"
    },
    "warnings": {
      "type": "array",
      "description": "需人工审阅的规范警告。",
      "items": {
        "type": "string",
        "description": "警告。"
      }
    },
    "capture_plan": {
      "$ref": "#/$defs/JsonObject"
    },
    "similar_results": {
      "type": "array",
      "description": "关键词相似的已有卡片。",
      "items": {
        "$ref": "#/$defs/RecallSearchResult"
      }
    },
    "similar_count": {
      "type": "integer",
      "description": "相似卡片数量。",
      "minimum": 0
    }
  },
  "required": [
    "ok",
    "card",
    "capture_plan",
    "similar_count"
  ],
  "$defs": {
    "JsonObject": {
      "type": "object",
      "description": "通用结构化对象。",
      "additionalProperties": true,
      "properties": {}
    },
    "RecallCard": {
      "type": "object",
      "description": "规范化后的 Recall 卡片。",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "卡片标题。"
        },
        "content": {
          "type": "string",
          "description": "卡片正文。"
        },
        "type": {
          "type": "string",
          "description": "卡片类型。"
        },
        "scope": {
          "type": "string",
          "description": "卡片作用域。"
        },
        "project": {
          "type": "string",
          "description": "项目标识。"
        },
        "status": {
          "type": "string",
          "description": "卡片状态。"
        },
        "confidence": {
          "type": "string",
          "description": "卡片可信度。"
        },
        "tags": {
          "type": "array",
          "description": "规范化标签。",
          "items": {
            "type": "string",
            "description": "标签。"
          }
        },
        "source": {
          "type": "string",
          "description": "信息来源。"
        },
        "evidence": {
          "type": "string",
          "description": "验证证据。"
        },
        "boundary": {
          "type": "string",
          "description": "适用边界。"
        },
        "path": {
          "type": "string",
          "description": "最终 Recall 相对路径。"
        }
      },
      "required": [
        "title",
        "content",
        "type",
        "scope",
        "project",
        "status",
        "confidence",
        "source",
        "path"
      ]
    },
    "RecallSearchResult": {
      "type": "object",
      "description": "Recall 关键词搜索命中。",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Recall 相对路径。"
        },
        "title": {
          "type": "string",
          "description": "Markdown 标题。"
        },
        "snippet": {
          "type": "string",
          "description": "命中位置附近的文本片段。"
        },
        "frontmatter": {
          "type": "object",
          "description": "命中文档 Frontmatter。",
          "additionalProperties": {
            "type": "string",
            "description": "Frontmatter 字段值。"
          },
          "properties": {}
        },
        "matched_terms": {
          "type": "array",
          "description": "命中的查询词。",
          "items": {
            "type": "string",
            "description": "查询词。"
          }
        },
        "matched_fields": {
          "type": "array",
          "description": "命中的文档字段。",
          "items": {
            "type": "string",
            "description": "字段名。"
          }
        }
      },
      "required": [
        "path",
        "snippet",
        "frontmatter"
      ]
    }
  }
}
