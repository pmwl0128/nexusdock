{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/CommandProgress.json",
  "title": "CommandProgress",
  "$defs": {
    "JsonObject": {
      "type": "object",
      "description": "通用结构化对象。",
      "additionalProperties": true,
      "properties": {}
    },
    "ErrorDetail": {
      "type": "object",
      "description": "字段级错误详情。",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "description": "字段路径。"
        },
        "reason": {
          "type": "string",
          "description": "稳定原因标识。"
        },
        "message": {
          "type": "string",
          "description": "可读错误说明。"
        }
      },
      "required": [
        "reason",
        "message"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "description": "统一错误响应。",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "稳定错误码。"
        },
        "message": {
          "type": "string",
          "description": "面向调用方的错误说明。"
        },
        "request_id": {
          "type": "string",
          "description": "请求关联 ID。"
        },
        "details": {
          "type": "array",
          "description": "可选字段级错误。",
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          }
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ]
    },
    "LegacyErrorEnvelope": {
      "type": "object",
      "description": "RecallDock 与浏览器接口使用的错误信封。",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "固定为 false。"
        },
        "error": {
          "type": "object",
          "description": "错误详情。",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "description": "稳定错误码。"
            },
            "message": {
              "type": "string",
              "description": "可读错误说明。"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "ok",
        "error"
      ]
    },
    "HealthResponse": {
      "type": "object",
      "description": "服务健康状态。",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "服务是否健康。"
        },
        "service": {
          "type": "string",
          "description": "服务名称。"
        }
      },
      "required": [
        "ok",
        "service"
      ]
    },
    "SystemStatus": {
      "type": "object",
      "description": "Nexus 系统与数据存储状态。",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "系统是否健康。"
        },
        "service": {
          "type": "string",
          "description": "服务名称。"
        },
        "database": {
          "type": "string",
          "description": "SQLite 健康状态。"
        },
        "schema_version": {
          "type": "integer",
          "description": "数据库 Schema 版本。",
          "minimum": 0
        },
        "recall_root": {
          "type": "string",
          "description": "RecallDock 召回仓库路径。"
        },
        "artifact_root": {
          "type": "string",
          "description": "Artifact 密文存储路径。"
        }
      },
      "required": [
        "ok",
        "service",
        "database",
        "schema_version",
        "recall_root",
        "artifact_root"
      ]
    },
    "BackupHistory": {
      "type": "object",
      "description": "一次备份执行的脱敏结果。",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "description": "状态文件版本。",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "description": "备份状态。",
          "enum": [
            "never_run",
            "queued",
            "running",
            "success",
            "failed",
            "unknown",
            "disabled"
          ]
        },
        "message": {
          "type": "string",
          "description": "状态说明。"
        },
        "started_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "host": {
          "type": "string",
          "description": "执行设备。"
        },
        "archive": {
          "type": "string",
          "description": "归档文件名。"
        },
        "archive_size": {
          "type": "integer",
          "description": "归档字节数。",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "description": "归档 SHA-256。"
        },
        "remote_path": {
          "type": "string",
          "description": "脱敏后的远端路径。"
        }
      },
      "required": [
        "state"
      ]
    },
    "BackupStatus": {
      "type": "object",
      "description": "AgentDock 与 Nexus 的单一备份状态。",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "稳定备份标识。"
        },
        "title": {
          "type": "string",
          "description": "备份名称。"
        },
        "description": {
          "type": "string",
          "description": "备份内容说明。"
        },
        "provider": {
          "type": "string",
          "description": "计划执行提供方。"
        },
        "device": {
          "type": "string",
          "description": "执行设备。"
        },
        "enabled": {
          "type": "boolean",
          "description": "备份是否启用。"
        },
        "schedule": {
          "type": "string",
          "description": "可读计划。"
        },
        "schedule_type": {
          "type": "string",
          "description": "计划类型。"
        },
        "state": {
          "type": "string",
          "description": "备份状态。",
          "enum": [
            "never_run",
            "queued",
            "running",
            "success",
            "failed",
            "unknown",
            "disabled"
          ]
        },
        "last_started_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "last_completed_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "next_run_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "message": {
          "type": "string",
          "description": "状态说明。"
        },
        "archive": {
          "type": "string",
          "description": "最近归档文件名。"
        },
        "archive_size": {
          "type": "integer",
          "description": "最近归档字节数。",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "description": "最近归档 SHA-256。"
        },
        "remote_path": {
          "type": "string",
          "description": "脱敏后的远端路径。"
        },
        "history": {
          "type": "array",
          "description": "最近备份历史。",
          "items": {
            "$ref": "#/$defs/BackupHistory"
          }
        }
      },
      "required": [
        "id",
        "title",
        "provider",
        "device",
        "enabled",
        "schedule",
        "state",
        "next_run_at",
        "history"
      ]
    },
    "DeviceCapability": {
      "type": "object",
      "description": "设备能力声明。",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "稳定能力名。"
        },
        "version": {
          "type": "string",
          "description": "能力版本。"
        },
        "enabled": {
          "type": "boolean",
          "description": "当前是否启用。"
        },
        "metadata": {
          "type": "object",
          "description": "非敏感扩展元数据。",
          "additionalProperties": true,
          "properties": {}
        }
      },
      "required": [
        "name",
        "version",
        "enabled"
      ]
    },
    "DeviceEnrollmentRequest": {
      "type": "object",
      "description": "设备注册请求。",
      "additionalProperties": false,
      "properties": {
        "enrollment_token": {
          "type": "string",
          "description": "一次性注册 token。",
          "minLength": 16
        },
        "name": {
          "type": "string",
          "description": "设备显示名称。"
        },
        "platform": {
          "type": "string",
          "description": "平台。",
          "enum": [
            "darwin",
            "linux"
          ]
        },
        "arch": {
          "type": "string",
          "description": "架构。",
          "enum": [
            "arm64",
            "amd64"
          ]
        },
        "agentdock_version": {
          "type": "string",
          "description": "AgentDock 版本。"
        },
        "public_key": {
          "type": "string",
          "description": "设备公钥。"
        },
        "labels": {
          "type": "object",
          "description": "设备标签。",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {}
        }
      },
      "required": [
        "enrollment_token",
        "name",
        "platform",
        "arch",
        "agentdock_version",
        "public_key"
      ]
    },
    "DeviceEnrollmentResponse": {
      "type": "object",
      "description": "设备注册结果。",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string",
          "description": "全局唯一标识符。",
          "format": "uuid"
        },
        "device_token": {
          "type": "string",
          "description": "设备认证 token；仅返回一次。"
        },
        "token_expires_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "heartbeat_interval_seconds": {
          "type": "integer",
          "description": "心跳建议间隔。",
          "minimum": 10,
          "maximum": 300
        },
        "server_time": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "device_id",
        "device_token",
        "token_expires_at",
        "heartbeat_interval_seconds",
        "server_time"
      ]
    },
    "EnrollmentTokenCreateRequest": {
      "type": "object",
      "description": "创建一次性设备注册 token。",
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "type": "string",
          "description": "创建主体标识。"
        },
        "ttl_seconds": {
          "type": "integer",
          "description": "有效期秒数。",
          "minimum": 60,
          "maximum": 604800
        },
        "allowed_command_types": {
          "type": "array",
          "description": "允许的结构化命令类型。",
          "items": {
            "type": "string",
            "description": "命令类型。",
            "enum": [
              "health.check",
              "skill.install",
              "skill.run",
              "skill.rollback",
              "recall.sync",
              "service.inspect",
              "service.restart",
              "diagnostics.collect",
              "agentdock.reload",
              "env.manage",
              "artifact.pull",
              "artifact.fetch"
            ]
          }
        },
        "max_risk": {
          "type": "string",
          "description": "最大允许风险。",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "created_by",
        "ttl_seconds",
        "allowed_command_types",
        "max_risk"
      ]
    },
    "EnrollmentTokenCreateResponse": {
      "type": "object",
      "description": "一次性设备注册 token。",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "description": "仅返回一次的明文注册 token。"
        },
        "expires_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "token",
        "expires_at"
      ]
    },
    "CommandLeaseAction": {
      "type": "object",
      "description": "命令租约动作请求。",
      "additionalProperties": false,
      "properties": {
        "lease_id": {
          "type": "string",
          "description": "全局唯一标识符。",
          "format": "uuid"
        }
      },
      "required": [
        "lease_id"
      ]
    },
    "DeviceTokenRotationResponse": {
      "type": "object",
      "description": "设备 token 轮换结果。",
      "additionalProperties": false,
      "properties": {
        "device_token": {
          "type": "string",
          "description": "新设备 token；仅返回一次。"
        },
        "token_expires_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "device_token",
        "token_expires_at"
      ]
    },
    "DeviceRevokeRequest": {
      "type": "object",
      "description": "撤销设备请求。",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "description": "撤销原因。",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "reason"
      ]
    },
    "DeviceCommandCreateRequest": {
      "type": "object",
      "description": "创建受控设备命令。",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "命令类型。",
          "enum": [
            "health.check",
            "skill.install",
            "skill.run",
            "skill.rollback",
            "recall.sync",
            "service.inspect",
            "service.restart",
            "diagnostics.collect",
            "agentdock.reload",
            "env.manage",
            "artifact.pull",
            "artifact.fetch"
          ]
        },
        "payload": {
          "type": "object",
          "description": "命令结构化参数；不得包含明文 Secret。",
          "additionalProperties": true,
          "properties": {}
        },
        "risk": {
          "type": "string",
          "description": "风险等级。",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "description": "副作用幂等键。",
          "minLength": 8,
          "maxLength": 128
        },
        "priority": {
          "type": "integer",
          "description": "调度优先级。",
          "minimum": -100,
          "maximum": 100
        },
        "max_attempts": {
          "type": "integer",
          "description": "最大尝试次数。",
          "minimum": 1,
          "maximum": 20
        },
        "not_before": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "payload",
        "risk",
        "idempotency_key",
        "priority",
        "max_attempts",
        "not_before",
        "expires_at"
      ]
    },
    "DeviceEnvActionRequest": {
      "type": "object",
      "description": "创建设备 Env 管理动作；响应必须脱敏 value。",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "Env 管理动作。",
          "enum": [
            "list",
            "inspect",
            "set",
            "delete",
            "verify",
            "migrate-from-agentdock-env"
          ]
        },
        "skill": {
          "type": [
            "string",
            "null"
          ],
          "description": "Runtime 上报的 Skill 名称。"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Runtime 上报的环境变量名。"
        },
        "kind": {
          "type": "string",
          "description": "变量类型。",
          "enum": [
            "plain",
            "secret"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "description": "写入值；API 响应不得回显明文。"
        },
        "operation": {
          "type": [
            "string",
            "null"
          ],
          "description": "verify 使用的 operation。"
        },
        "env_file": {
          "type": [
            "string",
            "null"
          ],
          "description": "迁移来源 env 文件路径。"
        }
      },
      "required": [
        "action"
      ]
    },
    "DeviceHeartbeat": {
      "type": "object",
      "description": "设备心跳快照。",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string",
          "description": "全局唯一标识符。",
          "format": "uuid"
        },
        "sent_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "uptime_seconds": {
          "type": "integer",
          "description": "进程运行秒数。",
          "minimum": 0
        },
        "agentdock_version": {
          "type": "string",
          "description": "AgentDock 版本。"
        },
        "metrics": {
          "type": "object",
          "description": "基础资源指标。",
          "additionalProperties": true,
          "properties": {}
        },
        "capabilities": {
          "type": "array",
          "description": "设备能力。",
          "items": {
            "$ref": "#/$defs/DeviceCapability"
          }
        },
        "skill_summary": {
          "type": "object",
          "description": "设备 Runtime 上报的 Skill 状态摘要。",
          "additionalProperties": true,
          "properties": {}
        },
        "recall_sync_summary": {
          "type": "object",
          "description": "Recall 同步摘要。",
          "additionalProperties": true,
          "properties": {}
        }
      },
      "required": [
        "device_id",
        "sent_at",
        "uptime_seconds",
        "agentdock_version",
        "metrics",
        "capabilities"
      ]
    },
    "DeviceStatus": {
      "type": "object",
      "description": "设备控制面状态。",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string",
          "description": "全局唯一标识符。",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "description": "设备状态。",
          "enum": [
            "pending",
            "online",
            "degraded",
            "offline",
            "revoked"
          ]
        },
        "last_seen_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "agentdock_version": {
          "type": "string",
          "description": "AgentDock 版本。"
        },
        "labels": {
          "type": "object",
          "description": "设备标签。",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {}
        },
        "capabilities": {
          "type": "array",
          "description": "最近能力快照。",
          "items": {
            "$ref": "#/$defs/DeviceCapability"
          }
        },
        "version": {
          "type": "integer",
          "description": "资源乐观锁版本，从 1 开始。",
          "minimum": 1
        }
      },
      "required": [
        "device_id",
        "status",
        "last_seen_at",
        "agentdock_version",
        "labels",
        "capabilities",
        "version"
      ]
    },
    "DeviceCommand": {
      "type": "object",
      "description": "受控设备命令；不允许任意 Shell。",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "全局唯一标识符。",
          "format": "uuid"
        },
        "device_id": {
          "type": "string",
          "description": "全局唯一标识符。",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "description": "命令类型。",
          "enum": [
            "health.check",
            "skill.install",
            "skill.run",
            "skill.rollback",
            "recall.sync",
            "service.inspect",
            "service.restart",
            "diagnostics.collect",
            "agentdock.reload",
            "env.manage",
            "artifact.pull",
            "artifact.fetch"
          ]
        },
        "status": {
          "type": "string",
          "description": "命令状态。",
          "enum": [
            "queued",
            "leased",
            "running",
            "succeeded",
            "failed",
            "expired",
            "cancelled"
          ]
        },
        "payload": {
          "type": "object",
          "description": "命令结构化参数。",
          "additionalProperties": true,
          "properties": {}
        },
        "risk": {
          "type": "string",
          "description": "风险等级。",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "description": "副作用幂等键。"
        },
        "created_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "attempt": {
          "type": "integer",
          "description": "当前尝试次数。",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "description": "最大尝试次数。",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "id",
