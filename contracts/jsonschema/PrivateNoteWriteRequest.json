{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteWriteRequest.json",
  "title": "PrivateNoteWriteRequest",
  "type": "object",
  "description": "创建或覆盖私密笔记请求。",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "description": "可选的 notes/ 相对路径。"
    },
    "category": {
      "type": "string",
      "description": "未传 path 时使用的分类。"
    },
    "title": {
      "type": "string",
      "description": "标题，也可用于生成路径。"
    },
    "summary": {
      "type": "string",
      "description": "可安全检索的人工简介。"
    },
    "tags": {
      "type": "array",
      "description": "可安全检索的标签。",
      "items": {
        "type": "string",
        "description": "标签。"
      }
    },
    "content": {
      "type": "string",
      "description": "私密笔记正文。"
    },
    "confirmed": {
      "type": "boolean",
      "description": "真实写入必须为 true。"
    },
    "overwrite": {
      "type": "boolean",
      "description": "是否覆盖已有笔记。"
    }
  },
  "required": [
    "content",
    "confirmed"
  ]
}
