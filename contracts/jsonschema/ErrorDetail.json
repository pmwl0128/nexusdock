{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/ErrorDetail.json",
  "title": "ErrorDetail",
  "type": "object",
  "description": "字段级错误详情。",
  "additionalProperties": false,
  "properties": {
    "field": {
      "type": "string",
      "description": "字段路径。"
    },
    "reason": {
      "type": "string",
      "description": "稳定原因标识。"
    },
    "message": {
      "type": "string",
      "description": "可读错误说明。"
    }
  },
  "required": [
    "reason",
    "message"
  ]
}
