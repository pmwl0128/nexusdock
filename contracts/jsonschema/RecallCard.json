{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/RecallCard.json",
  "title": "RecallCard",
  "type": "object",
  "description": "规范化后的 Recall 卡片。",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "卡片标题。"
    },
    "content": {
      "type": "string",
      "description": "卡片正文。"
    },
    "type": {
      "type": "string",
      "description": "卡片类型。"
    },
    "scope": {
      "type": "string",
      "description": "卡片作用域。"
    },
    "project": {
      "type": "string",
      "description": "项目标识。"
    },
    "status": {
      "type": "string",
      "description": "卡片状态。"
    },
    "confidence": {
      "type": "string",
      "description": "卡片可信度。"
    },
    "tags": {
      "type": "array",
      "description": "规范化标签。",
      "items": {
        "type": "string",
        "description": "标签。"
      }
    },
    "source": {
      "type": "string",
      "description": "信息来源。"
    },
    "evidence": {
      "type": "string",
      "description": "验证证据。"
    },
    "boundary": {
      "type": "string",
      "description": "适用边界。"
    },
    "path": {
      "type": "string",
      "description": "最终 Recall 相对路径。"
    }
  },
  "required": [
    "title",
    "content",
    "type",
    "scope",
    "project",
    "status",
    "confidence",
    "source",
    "path"
  ]
}
