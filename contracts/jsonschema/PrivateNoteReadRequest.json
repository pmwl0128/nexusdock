{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteReadRequest.json",
  "title": "PrivateNoteReadRequest",
  "type": "object",
  "description": "显式读取私密笔记正文的请求。",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "description": "notes/ 下的私密笔记相对路径。"
    },
    "max_bytes": {
      "type": "integer",
      "description": "最大返回字节数。",
      "minimum": 1,
      "maximum": 1048576
    }
  },
  "required": [
    "path"
  ]
}
