{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/RuntimeErrorEnvelope.json",
  "title": "RuntimeErrorEnvelope",
  "type": "object",
  "description": "AgentDock Runtime 不可用或拒绝请求时的错误信封。",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "固定为 false。"
    },
    "available": {
      "type": "boolean",
      "description": "固定为 false，表示目标 Runtime 当前不可用。"
    },
    "source": {
      "type": "string",
      "description": "错误来源，固定为 agentdock-runtime-api。"
    },
    "request_id": {
      "type": "string",
      "description": "请求关联 ID。"
    },
    "error": {
      "type": "object",
      "description": "稳定 Nexus 错误及可选的上游错误码。",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "Nexus 稳定错误码。"
        },
        "message": {
          "type": "string",
          "description": "可读错误说明。"
        },
        "upstream_code": {
          "type": "string",
          "description": "AgentDock Runtime 返回的原始错误码。"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "ok",
    "available",
    "source",
    "request_id",
    "error"
  ]
}
