{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/RecallWriteRequest.json",
  "title": "RecallWriteRequest",
  "type": "object",
  "description": "创建或覆盖 Recall 文本记录。",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "description": "Recall 相对路径；PATCH 时由路径参数覆盖。",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "description": "Markdown 或文本内容。"
    },
    "type": {
      "type": "string",
      "description": "可选的 Recall 类型。"
    },
    "scope": {
      "type": "string",
      "description": "Recall 作用域。",
      "enum": [
        "profile",
        "global",
        "project",
        "device",
        "agent",
        "ops",
        "inbox"
      ]
    },
    "status": {
      "type": "string",
      "description": "Recall 状态。",
      "enum": [
        "inbox",
        "active",
        "verified",
        "stale",
        "archived",
        "rejected",
        "conflicted",
        "unverified",
        "deprecated"
      ]
    },
    "project": {
      "type": "string",
      "description": "项目标识。"
    },
    "device": {
      "type": "string",
      "description": "设备标识。"
    },
    "agent": {
      "type": "string",
      "description": "Agent 标识。"
    },
    "skill": {
      "type": "string",
      "description": "Skill 标识。"
    },
    "source": {
      "type": "string",
      "description": "信息来源。"
    },
    "confidence": {
      "type": "string",
      "description": "可信度。",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ]
    },
    "verified_at": {
      "type": "string",
      "description": "RFC 3339 UTC 时间。",
      "format": "date-time"
    },
    "verification_run_id": {
      "type": "string",
      "description": "验证运行 ID。"
    },
    "source_device": {
      "type": "string",
      "description": "验证来源设备。"
    },
    "source_agent": {
      "type": "string",
      "description": "验证来源 Agent。"
    },
    "tags": {
      "type": "array",
      "description": "Recall 标签。",
      "items": {
        "type": "string",
        "description": "标签。"
      }
    },
    "confirmed": {
      "type": "boolean",
      "description": "写入受保护目录时的确认标记。"
    },
    "overwrite": {
      "type": "boolean",
      "description": "是否覆盖已有文件。"
    }
  },
  "required": [
    "content"
  ]
}
