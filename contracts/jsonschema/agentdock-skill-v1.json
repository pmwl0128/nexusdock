{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/skill/v1/agentdock-skill-v1.json",
  "title": "AgentDock Skill Manifest V1",
  "type": "object",
  "description": "AgentDock Skill 包清单。",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agentdock.dev/v1",
      "description": "Skill manifest API 版本。"
    },
    "kind": {
      "const": "Skill",
      "description": "固定资源类型。"
    },
    "metadata": {
      "type": "object",
      "description": "Skill 元数据。",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "稳定 Skill 名。",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "version": {
          "type": "string",
          "description": "语义版本。",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "displayName": {
          "type": "string",
          "description": "显示名称。",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Skill 说明。",
          "minLength": 1,
          "maxLength": 2000
        },
        "license": {
          "type": "string",
          "description": "SPDX 或许可证说明。"
        },
        "homepage": {
          "type": "string",
          "description": "主页。",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "version",
        "displayName",
        "description"
      ]
    },
    "spec": {
      "type": "object",
      "description": "Skill 运行声明。",
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "type": "string",
          "description": "包内相对入口路径。",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "operations": {
          "type": "array",
          "description": "Operations。",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "Skill operation 声明。",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Operation 名。",
                "pattern": "^[a-z][a-z0-9._-]*$"
              },
              "description": {
                "type": "string",
                "description": "Operation 说明。",
                "minLength": 1
              },
              "inputSchema": {
                "type": "object",
                "description": "输入 JSON Schema。",
                "additionalProperties": true,
                "properties": {}
              },
              "outputSchema": {
                "type": "object",
                "description": "输出 JSON Schema。",
                "additionalProperties": true,
                "properties": {}
              },
              "timeoutSeconds": {
                "type": "integer",
                "description": "超时秒数。",
                "minimum": 1,
                "maximum": 86400
              }
            },
            "required": [
              "name",
              "description",
              "inputSchema",
              "outputSchema",
              "timeoutSeconds"
            ]
          }
        },
        "compatibility": {
          "type": "object",
          "description": "兼容性。",
          "additionalProperties": false,
          "properties": {
            "platforms": {
              "type": "array",
              "description": "支持平台。",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "darwin",
                  "linux"
                ]
              }
            },
            "architectures": {
              "type": "array",
              "description": "支持架构。",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "arm64",
                  "amd64"
                ]
              }
            },
            "agentdock": {
              "type": "string",
              "description": "兼容的 AgentDock 版本约束。"
            }
          },
          "required": [
            "platforms",
            "architectures",
            "agentdock"
          ]
        },
        "permissions": {
          "type": "object",
          "description": "显式权限声明。",
          "additionalProperties": false,
          "properties": {
            "filesystem": {
              "type": "array",
              "description": "声明文件访问。",
              "items": {
                "type": "string",
                "description": "路径或访问模式。"
              }
            },
            "network": {
              "type": "array",
              "description": "声明网络目标。",
              "items": {
                "type": "string",
                "description": "网络目标。"
              }
            },
            "secrets": {
              "type": "array",
              "description": "Secret 逻辑名。",
              "items": {
                "type": "string",
                "description": "Secret 名。"
              }
            },
            "commands": {
              "type": "array",
              "description": "允许子进程命令。",
              "items": {
                "type": "string",
                "description": "命令名。"
              }
            }
          },
          "required": [
            "filesystem",
            "network",
            "secrets",
            "commands"
          ]
        },
        "bindings": {
          "type": "array",
          "description": "所需设备 Binding 名。",
          "items": {
            "type": "string",
            "description": "Binding 名。"
          }
        },
        "verification": {
          "type": "array",
          "description": "发布和回退后的验证项。",
          "items": {
            "type": "string",
            "description": "验证项。"
          }
        }
      },
      "required": [
        "entrypoint",
        "operations",
        "compatibility",
        "permissions"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}
