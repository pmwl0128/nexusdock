{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/AgentDockNodeUpdateRequest.json",
  "title": "AgentDockNodeUpdateRequest",
  "type": "object",
  "description": "更新 AgentDock 节点；省略 token 时保留现有凭据。",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "节点显示名称。",
      "minLength": 1,
      "maxLength": 100
    },
    "endpoint": {
      "type": "string",
      "description": "AgentDock HTTP/HTTPS Origin。",
      "format": "uri"
    },
    "token": {
      "type": "string",
      "description": "替换该节点的 Bearer Token。",
      "minLength": 1,
      "maxLength": 16384,
      "writeOnly": true
    },
    "enabled": {
      "type": "boolean",
      "description": "节点是否启用。"
    },
    "timeout_seconds": {
      "type": "integer",
      "description": "请求超时秒数。",
      "minimum": 1,
      "maximum": 300
    }
  }
}
