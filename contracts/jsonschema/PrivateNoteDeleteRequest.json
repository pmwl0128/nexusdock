{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteDeleteRequest.json",
  "title": "PrivateNoteDeleteRequest",
  "type": "object",
  "description": "同时删除私密笔记明文和 age 密文的请求。",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "description": "notes/ 下的私密笔记相对路径。"
    },
    "confirmed": {
      "type": "boolean",
      "description": "真实删除必须为 true。"
    }
  },
  "required": [
    "path",
    "confirmed"
  ]
}
