{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteDeleteResponse.json",
  "title": "PrivateNoteDeleteResponse",
  "type": "object",
  "description": "私密笔记明文与 age 密文删除结果。",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "description": "固定为 delete。"
    },
    "root": {
      "type": "string",
      "description": "Nexus 私密笔记根目录。"
    },
    "path": {
      "type": "string",
      "description": "明文相对路径。"
    },
    "encrypted_path": {
      "type": "string",
      "description": "age 密文相对路径。"
    },
    "deleted_plaintext": {
      "type": "boolean",
      "description": "明文是否删除。"
    },
    "deleted_encrypted": {
      "type": "boolean",
      "description": "密文是否删除。"
    }
  },
  "required": [
    "action",
    "root",
    "path",
    "encrypted_path",
    "deleted_plaintext",
    "deleted_encrypted"
  ]
}
