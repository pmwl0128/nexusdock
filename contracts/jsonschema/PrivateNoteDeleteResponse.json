{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteDeleteResponse.json",
  "title": "PrivateNoteDeleteResponse",
  "$defs": {
    "JsonObject": {
      "type": "object",
      "description": "通用结构化对象。",
      "additionalProperties": true,
      "properties": {}
    },
    "ErrorDetail": {
      "type": "object",
      "description": "字段级错误详情。",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "description": "字段路径。"
        },
        "reason": {
          "type": "string",
          "description": "稳定原因标识。"
        },
        "message": {
          "type": "string",
          "description": "可读错误说明。"
        }
      },
      "required": [
        "reason",
        "message"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "description": "统一错误响应。",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "稳定错误码。"
        },
        "message": {
          "type": "string",
          "description": "面向调用方的错误说明。"
        },
        "request_id": {
          "type": "string",
          "description": "请求关联 ID。"
        },
        "details": {
          "type": "array",
          "description": "可选字段级错误。",
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          }
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ]
    },
    "LegacyErrorEnvelope": {
      "type": "object",
      "description": "Nexus 与浏览器接口使用的错误信封。",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "固定为 false。"
        },
        "error": {
          "type": "object",
          "description": "错误详情。",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "description": "稳定错误码。"
            },
            "message": {
              "type": "string",
              "description": "可读错误说明。"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "ok",
        "error"
      ]
    },
    "HealthResponse": {
      "type": "object",
      "description": "服务健康状态。",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "服务是否健康。"
        },
        "service": {
          "type": "string",
          "description": "服务名称。"
        }
      },
      "required": [
        "ok",
        "service"
      ]
    },
    "SystemStatus": {
      "type": "object",
      "description": "Nexus 系统与数据存储状态。",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "系统是否健康。"
        },
        "service": {
          "type": "string",
          "description": "服务名称，固定为 nexusdock。"
        },
        "database": {
          "type": "string",
          "description": "SQLite 健康状态。"
        },
        "schema_version": {
          "type": "integer",
          "description": "数据库 Schema 版本。",
          "minimum": 0
        },
        "nexus_data_dir": {
          "type": "string",
          "description": "Nexus 系统状态目录。"
        },
        "recall_repo_dir": {
          "type": "string",
          "description": "Recall Git Markdown 仓库目录。"
        }
      },
      "required": [
        "ok",
        "service",
        "database",
        "schema_version",
        "nexus_data_dir",
        "recall_repo_dir"
      ]
    },
    "BackupHistory": {
      "type": "object",
      "description": "一次备份执行的脱敏结果。",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "description": "状态文件版本。",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "description": "备份状态。",
          "enum": [
            "never_run",
            "queued",
            "running",
            "success",
            "failed",
            "unknown",
            "disabled"
          ]
        },
        "message": {
          "type": "string",
          "description": "状态说明。"
        },
        "started_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "host": {
          "type": "string",
          "description": "执行主机。"
        },
        "archive": {
          "type": "string",
          "description": "归档文件名。"
        },
        "archive_size": {
          "type": "integer",
          "description": "归档字节数。",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "description": "归档 SHA-256。"
        },
        "remote_path": {
          "type": "string",
          "description": "脱敏后的远端路径。"
        }
      },
      "required": [
        "state"
      ]
    },
    "BackupStatus": {
      "type": "object",
      "description": "AgentDock 与 Nexus 的单一备份状态。",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "稳定备份标识。"
        },
        "title": {
          "type": "string",
          "description": "备份名称。"
        },
        "description": {
          "type": "string",
          "description": "备份内容说明。"
        },
        "provider": {
          "type": "string",
          "description": "计划执行提供方。"
        },
        "host": {
          "type": "string",
          "description": "执行主机。"
        },
        "enabled": {
          "type": "boolean",
          "description": "备份是否启用。"
        },
        "schedule": {
          "type": "string",
          "description": "可读计划。"
        },
        "schedule_type": {
          "type": "string",
          "description": "计划类型。"
        },
        "state": {
          "type": "string",
          "description": "备份状态。",
          "enum": [
            "never_run",
            "queued",
            "running",
            "success",
            "failed",
            "unknown",
            "disabled"
          ]
        },
        "last_started_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "last_completed_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "next_run_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "message": {
          "type": "string",
          "description": "状态说明。"
        },
        "archive": {
          "type": "string",
          "description": "最近归档文件名。"
        },
        "archive_size": {
          "type": "integer",
          "description": "最近归档字节数。",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "description": "最近归档 SHA-256。"
        },
        "remote_path": {
          "type": "string",
          "description": "脱敏后的远端路径。"
        },
        "history": {
          "type": "array",
          "description": "最近备份历史。",
          "items": {
            "$ref": "#/$defs/BackupHistory"
          }
        }
      },
      "required": [
        "id",
        "title",
        "provider",
        "host",
        "enabled",
        "schedule",
        "state",
        "next_run_at",
        "history"
      ]
    },
    "RecallEntry": {
      "type": "object",
      "description": "Markdown 召回条目。",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "召回相对路径。"
        },
        "content": {
          "type": "string",
          "description": "Markdown 或文本内容。"
        },
        "size_bytes": {
          "type": "integer",
          "description": "内容字节数。",
          "minimum": 0
        },
        "modified_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "path"
      ]
    },
    "PrivateNoteSummary": {
      "type": "object",
      "description": "私密笔记安全元数据；不包含正文或正文片段。",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "notes/ 下的私密笔记相对路径。"
        },
        "encrypted_path": {
          "type": "string",
          "description": "对应 age 密文相对路径。"
        },
        "category": {
          "type": "string",
          "description": "私密笔记分类。"
        },
        "title": {
          "type": "string",
          "description": "私密笔记标题。"
        },
        "summary": {
          "type": "string",
          "description": "人工维护的安全简介。"
        },
        "tags": {
          "type": "array",
          "description": "安全标签。",
          "items": {
            "type": "string",
            "description": "标签。"
          }
        },
        "updated_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "contains_secret": {
          "type": "boolean",
          "description": "正文是否被标记为含敏感信息。"
        },
        "score": {
          "type": "integer",
          "description": "元数据检索匹配分数。",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "encrypted_path",
        "contains_secret"
      ]
    },
    "PrivateNoteSearchRequest": {
      "type": "object",
      "description": "私密笔记元数据检索请求。",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "description": "仅匹配标题、简介、标签、分类和路径的查询。"
        },
        "max_results": {
          "type": "integer",
          "description": "最大结果数。",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "query"
      ]
    },
    "PrivateNoteSearchResponse": {
      "type": "object",
      "description": "私密笔记元数据检索结果。",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "请求是否成功。"
        },
        "action": {
          "type": "string",
          "description": "固定为 search。"
        },
        "query": {
          "type": "string",
          "description": "原始查询。"
        },
        "root": {
          "type": "string",
          "description": "Nexus 私密笔记根目录。"
        },
        "results": {
          "type": "array",
          "description": "仅含安全元数据的结果。",
          "items": {
            "$ref": "#/$defs/PrivateNoteSummary"
          }
        },
        "count": {
          "type": "integer",
          "description": "结果数。",
          "minimum": 0
        },
        "metadata_only": {
          "type": "boolean",
          "description": "固定为 true。"
        },
        "policy": {
          "type": "string",
          "description": "检索安全策略说明。"
        }
      },
      "required": [
        "ok",
        "action",
        "query",
        "root",
        "results",
        "count",
        "metadata_only"
      ]
    },
    "PrivateNoteReadRequest": {
      "type": "object",
      "description": "显式读取私密笔记正文的请求。",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "notes/ 下的私密笔记相对路径。"
        },
        "max_bytes": {
          "type": "integer",
          "description": "最大返回字节数。",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "path"
      ]
    },
    "PrivateNoteReadResponse": {
      "type": "object",
      "description": "显式私密笔记明文读取结果。",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "固定为 read。"
        },
        "root": {
          "type": "string",
          "description": "Nexus 私密笔记根目录。"
        },
        "path": {
          "type": "string",
          "description": "明文相对路径。"
        },
        "encrypted_path": {
          "type": "string",
          "description": "age 密文相对路径。"
        },
        "content": {
          "type": "string",
          "description": "私密笔记明文，仅显式读取接口返回。"
        },
        "truncated": {
          "type": "boolean",
          "description": "正文是否被截断。"
        },
        "contains_secret": {
          "type": "boolean",
          "description": "正文是否被标记为含敏感信息。"
        }
      },
      "required": [
        "action",
        "root",
        "path",
        "encrypted_path",
        "content",
        "truncated",
        "contains_secret"
      ]
    },
    "PrivateNoteWriteRequest": {
      "type": "object",
      "description": "创建或覆盖私密笔记请求。",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "可选的 notes/ 相对路径。"
        },
        "category": {
          "type": "string",
          "description": "未传 path 时使用的分类。"
        },
        "title": {
          "type": "string",
          "description": "标题，也可用于生成路径。"
        },
        "summary": {
          "type": "string",
          "description": "可安全检索的人工简介。"
        },
        "tags": {
          "type": "array",
          "description": "可安全检索的标签。",
          "items": {
            "type": "string",
            "description": "标签。"
          }
        },
        "content": {
          "type": "string",
          "description": "私密笔记正文。"
        },
        "confirmed": {
          "type": "boolean",
          "description": "真实写入必须为 true。"
        },
        "overwrite": {
          "type": "boolean",
          "description": "是否覆盖已有笔记。"
        }
      },
      "required": [
        "content",
        "confirmed"
      ]
    },
    "PrivateNoteWriteResponse": {
      "type": "object",
      "description": "私密笔记明文与 age 密文原子写入结果。",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "固定为 write。"
        },
        "root": {
          "type": "string",
          "description": "Nexus 私密笔记根目录。"
        },
        "path": {
          "type": "string",
          "description": "明文相对路径。"
        },
        "encrypted_path": {
          "type": "string",
          "description": "age 密文相对路径。"
        },
        "written": {
          "type": "boolean",
          "description": "明文是否写入。"
        },
        "encrypted": {
          "type": "boolean",
          "description": "密文是否写入。"
        },
        "algorithm": {
          "type": "string",
          "description": "加密算法。"
        }
      },
      "required": [
        "action",
        "root",
        "path",
        "encrypted_path",
        "written",
        "encrypted",
        "algorithm"
      ]
    },
    "PrivateNoteDeleteRequest": {
      "type": "object",
      "description": "同时删除私密笔记明文和 age 密文的请求。",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "notes/ 下的私密笔记相对路径。"
        },
        "confirmed": {
          "type": "boolean",
          "description": "真实删除必须为 true。"
        }
      },
      "required": [
        "path",
        "confirmed"
      ]
    },
    "PrivateNoteDeleteResponse": {
      "type": "object",
      "description": "私密笔记明文与 age 密文删除结果。",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "固定为 delete。"
        },
        "root": {
          "type": "string",
          "description": "Nexus 私密笔记根目录。"
        },
        "path": {
          "type": "string",
          "description": "明文相对路径。"
        },
        "encrypted_path": {
          "type": "string",
          "description": "age 密文相对路径。"
        },
        "deleted_plaintext": {
          "type": "boolean",
          "description": "明文是否删除。"
        },
        "deleted_encrypted": {
          "type": "boolean",
          "description": "密文是否删除。"
        }
      },
      "required": [
        "action",
        "root",
        "path",
        "encrypted_path",
        "deleted_plaintext",
        "deleted_encrypted"
      ]
    },
    "PrivateNoteStatusRequest": {
      "type": "object",
      "description": "读取私密笔记状态或安全元数据列表。",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "状态动作。",
          "enum": [
            "check",
            "list"
          ]
        }
      },
      "required": [
        "action"
      ]
    },
    "PrivateNoteStatusResponse": {
      "type": "object",
      "description": "私密笔记加密和 Git 忽略状态。",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "执行的状态动作。"
        },
        "root": {
          "type": "string",
          "description": "Nexus 私密笔记根目录。"
        },
        "notes": {
          "type": "array",
          "description": "私密笔记安全元数据。",
          "items": {
            "$ref": "#/$defs/PrivateNoteSummary"
          }
        },
        "count": {
          "type": "integer",
          "description": "列表项数。",
          "minimum": 0
        },
        "notes_count": {
          "type": "integer",
          "description": "明文笔记数。",
          "minimum": 0
        },
        "missing_encrypted": {
          "type": "array",
          "description": "缺失的 age 密文路径。",
          "items": {
            "type": "string",
            "description": "密文路径。"
          }
        },
        "encrypted_backup_ok": {
          "type": "boolean",
          "description": "每条明文是否都有密文。"
        },
        "plaintext_git_ignored": {
          "type": "boolean",
          "description": "notes/ 是否由仓库规则忽略。"
        },
        "keys_git_ignored": {
          "type": "boolean",
          "description": ".keys/ 是否由仓库规则忽略。"
        }
      },
      "required": [
        "action",
        "root",
        "encrypted_backup_ok",
        "plaintext_git_ignored",
        "keys_git_ignored"
      ]
    },
    "PrivateNoteMaintenanceRequest": {
      "type": "object",
      "description": "私密笔记加密维护请求。",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "维护动作。",
          "enum": [
            "init",
            "init-encryption",
            "sync-encrypted",
            "encrypt-all"
          ]
        }
      },
      "required": [
        "action"
      ]
    },
    "PrivateNoteMaintenanceResponse": {
      "type": "object",
      "description": "私密笔记加密初始化或全量重加密结果。",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "执行的维护动作。"
        },
        "root": {
          "type": "string",
          "description": "Nexus 私密笔记根目录。"
        },
        "recipient": {
          "type": "string",
          "description": "age 公钥接收者。"
        },
        "identity_created": {
          "type": "boolean",
          "description": "是否新建 identity。"
        },
        "encrypted_count": {
          "type": "integer",
          "description": "生成的密文数量。",
          "minimum": 0
        },
        "algorithm": {
          "type": "string",
          "description": "加密算法。"
        }
      },
      "required": [
        "action",
        "root",
        "algorithm"
      ]
    },
    "AgentDockNode": {
      "type": "object",
      "description": "Nexus 管理的一台 AgentDock Runtime 节点。",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "稳定节点 ID。",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "description": "节点显示名称。",
          "minLength": 1,
          "maxLength": 100
        },
        "endpoint": {
          "type": "string",
          "description": "AgentDock HTTP/HTTPS Origin。",
          "format": "uri"
        },
        "enabled": {
          "type": "boolean",
          "description": "节点是否允许 Runtime 请求。"
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "请求超时秒数。",
          "minimum": 1,
          "maximum": 300
        },
        "token_configured": {
          "type": "boolean",
          "description": "节点 Token 是否已配置；不会返回 Token 原值。"
        },
        "created_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "endpoint",
        "enabled",
        "timeout_seconds",
        "token_configured",
        "created_at",
        "updated_at"
      ]
    },
    "AgentDockNodeCreateRequest": {
