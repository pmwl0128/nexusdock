{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/EmbeddingSearchRequest.json",
  "title": "EmbeddingSearchRequest",
  "type": "object",
  "description": "使用 Recall 向量索引执行语义搜索。",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "description": "语义查询。",
      "minLength": 1
    },
    "prefix": {
      "type": "string",
      "description": "可选的 Recall 路径前缀。"
    },
    "max_results": {
      "type": "integer",
      "description": "最大结果数。",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "query"
  ]
}
