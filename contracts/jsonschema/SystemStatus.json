{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/SystemStatus.json",
  "title": "SystemStatus",
  "type": "object",
  "description": "Nexus 系统与数据存储状态。",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "系统是否健康。"
    },
    "service": {
      "type": "string",
      "description": "服务名称，固定为 nexusdock。"
    },
    "database": {
      "type": "string",
      "description": "SQLite 健康状态。"
    },
    "schema_version": {
      "type": "integer",
      "description": "数据库 Schema 版本。",
      "minimum": 0
    },
    "nexus_data_dir": {
      "type": "string",
      "description": "Nexus 系统状态目录。"
    },
    "recall_repo_dir": {
      "type": "string",
      "description": "Recall Git Markdown 仓库目录。"
    }
  },
  "required": [
    "ok",
    "service",
    "database",
    "schema_version",
    "nexus_data_dir",
    "recall_repo_dir"
  ]
}
