{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteMaintenanceResponse.json",
  "title": "PrivateNoteMaintenanceResponse",
  "type": "object",
  "description": "私密笔记加密初始化或全量重加密结果。",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "description": "执行的维护动作。"
    },
    "root": {
      "type": "string",
      "description": "Nexus 私密笔记根目录。"
    },
    "recipient": {
      "type": "string",
      "description": "age 公钥接收者。"
    },
    "identity_created": {
      "type": "boolean",
      "description": "是否新建 identity。"
    },
    "encrypted_count": {
      "type": "integer",
      "description": "生成的密文数量。",
      "minimum": 0
    },
    "algorithm": {
      "type": "string",
      "description": "加密算法。"
    }
  },
  "required": [
    "action",
    "root",
    "algorithm"
  ]
}
