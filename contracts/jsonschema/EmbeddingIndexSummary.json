{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/EmbeddingIndexSummary.json",
  "title": "EmbeddingIndexSummary",
  "type": "object",
  "description": "Recall 向量索引摘要。",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "description": "索引使用的嵌入模型。"
    },
    "dimension": {
      "type": "integer",
      "description": "向量维度。",
      "minimum": 0
    },
    "count": {
      "type": "integer",
      "description": "索引文档数量。",
      "minimum": 0
    },
    "updated_at": {
      "type": "string",
      "description": "RFC 3339 UTC 时间。",
      "format": "date-time"
    }
  },
  "required": [
    "model",
    "count",
    "updated_at"
  ]
}
