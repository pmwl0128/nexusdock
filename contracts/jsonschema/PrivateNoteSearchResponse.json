{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentdock.dev/nexus/v1/PrivateNoteSearchResponse.json",
  "title": "PrivateNoteSearchResponse",
  "type": "object",
  "description": "私密笔记元数据检索结果。",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "请求是否成功。"
    },
    "action": {
      "type": "string",
      "description": "固定为 search。"
    },
    "query": {
      "type": "string",
      "description": "原始查询。"
    },
    "root": {
      "type": "string",
      "description": "Nexus 私密笔记根目录。"
    },
    "results": {
      "type": "array",
      "description": "仅含安全元数据的结果。",
      "items": {
        "$ref": "#/$defs/PrivateNoteSummary"
      }
    },
    "count": {
      "type": "integer",
      "description": "结果数。",
      "minimum": 0
    },
    "metadata_only": {
      "type": "boolean",
      "description": "固定为 true。"
    },
    "policy": {
      "type": "string",
      "description": "检索安全策略说明。"
    }
  },
  "required": [
    "ok",
    "action",
    "query",
    "root",
    "results",
    "count",
    "metadata_only"
  ],
  "$defs": {
    "PrivateNoteSummary": {
      "type": "object",
      "description": "私密笔记安全元数据；不包含正文或正文片段。",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "notes/ 下的私密笔记相对路径。"
        },
        "encrypted_path": {
          "type": "string",
          "description": "对应 age 密文相对路径。"
        },
        "category": {
          "type": "string",
          "description": "私密笔记分类。"
        },
        "title": {
          "type": "string",
          "description": "私密笔记标题。"
        },
        "summary": {
          "type": "string",
          "description": "人工维护的安全简介。"
        },
        "tags": {
          "type": "array",
          "description": "安全标签。",
          "items": {
            "type": "string",
            "description": "标签。"
          }
        },
        "updated_at": {
          "type": "string",
          "description": "RFC 3339 UTC 时间。",
          "format": "date-time"
        },
        "contains_secret": {
          "type": "boolean",
          "description": "正文是否被标记为含敏感信息。"
        },
        "score": {
          "type": "integer",
          "description": "元数据检索匹配分数。",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "encrypted_path",
        "contains_secret"
      ]
    }
  }
}
