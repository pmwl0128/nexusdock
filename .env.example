RECALLDOCK_HOST=127.0.0.1
RECALLDOCK_PORT=18777
RECALLDOCK_STORE_DIR=recall
RECALLDOCK_GITHUB_CREDENTIALS=/absolute/path/to/github_credentials
RECALLDOCK_AUTH_TOKEN=
RECALLDOCK_AUTO_SYNC=false
RECALLDOCK_PULL_INTERVAL_SECONDS=120
RECALLDOCK_PUSH_DEBOUNCE_SECONDS=10
RECALLDOCK_COMMIT_MESSAGE=recall: 自动同步召回库
RECALLDOCK_LOG_LEVEL=info

NEXUS_BACKUP_STATUS_DIR=/backup-status
